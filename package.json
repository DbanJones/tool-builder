{
  "name": "tool-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop app that lets absolute novices build production web apps by chatting with Claude. See spec.md.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar:install": "pnpm --dir sidecar install",
    "sidecar:build": "pnpm --dir sidecar build",
    "predev": "pnpm sidecar:build",
    "prebuild": "pnpm sidecar:build",
    "typecheck": "tsc --noEmit && pnpm --dir sidecar typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "pretest:integration": "pnpm sidecar:build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.11.0",
    "neverthrow": "8.2.0",
    "next": "15.5.15",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-plugin-neverthrow": "1.1.4",
    "jsdom": "25.0.1",
    "postcss": "8.4.31",
    "prettier": "3.8.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vitest": "2.1.9"
  }
}
